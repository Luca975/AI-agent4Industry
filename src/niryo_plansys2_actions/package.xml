<?xml version="1.0"?>
<package format="3">
  <name>niryo_plansys2_actions</name>
  <version>0.0.0</version>
  <description>PlanSys2 action performers for the Niryo Ned2: the move, pick
  and place lifecycle nodes that executes the planned actions on the arm
  and react to SafetyAlert.</description>
  <maintainer email="lu.cardellicchio@studenti.unina.it">Luca</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>plansys2_executor</depend>
  <depend>plansys2_msgs</depend>
  <depend>niryo_ned_ros2_interfaces</depend>
  <depend>niryo_world_interfaces</depend>
  <depend>lifecycle_msgs</depend>
  <depend>niryo_env_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>