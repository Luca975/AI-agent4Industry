<?xml version="1.0"?>
<package format="3">
  <name>niryo_world_interfaces</name>
  <version>0.0.0</version>
  <maintainer email="lu.cardellicchio@studenti.unina.it">Luca</maintainer>
  <description>Custom ROS2 interfaces for Niryo PlanSys2 integration</description>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>niryo_ned_ros2_interfaces</depend>
  <depend>std_msgs</depend>

  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>